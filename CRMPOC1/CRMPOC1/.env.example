# Copy to .env and adjust as needed

# Postgres (used by db service and api)
POSTGRES_USER=indcool
POSTGRES_PASSWORD=indcool_dev
POSTGRES_DB=indcool_crm
POSTGRES_PORT=5432

# API
API_PORT=8000
DATABASE_URL=Server=DESKTOP-N7O68K8\\MYSQL,1433;Database=indcool;User Id=api_user;Password=test123;Encrypt=no;TrustServerCertificate=yes;Driver=ODBC Driver 17 for SQL Server;
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
UPLOAD_DIR=/app/uploads
CORS_ORIGINS=http://localhost:5173

# GST lookup (GST Suvidha Provider, e.g. sandbox.co.in)
# Leave GST_LOOKUP_ENABLED=false to keep live GSTIN verification off (local
# format/checksum validation still works either way).
GST_LOOKUP_ENABLED=false
GST_PROVIDER_URL=https://api.sandbox.co.in/gst/compliance/public/gstin/search
GST_PROVIDER_API_KEY=key_live_7f115fdacad24e44b5efb653182c70dd
GST_PROVIDER_API_SECRET=secret_live_2caaa507963d45a6be9d9b34a5e5873a

# Seed admin (created by seed.py)
SEED_ADMIN_EMAIL=admin@indcool.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Administrator

# UI
UI_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_GST_LOOKUP_ENABLED=true
# Bump this value to invalidate every browser's cached GST lookups (cache
# normally lasts 1 hour) without waiting out the TTL.
VITE_GST_CACHE_RESET_KEY=1
