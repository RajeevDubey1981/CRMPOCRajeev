DATABASE_BACKEND=mysql

# MySQL example
MYSQL_DATABASE_URL=mysql+mysqlconnector://root:your_password@YOUR_DB_HOST:3306/indcool

# SQL Server example
SQLSERVER_DATABASE_URL=Server=YOUR_DB_HOST,1433;Database=indcool;User Id=api_user;Password=your_password;Encrypt=no;TrustServerCertificate=yes;Driver=ODBC Driver 18 for SQL Server;

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
UPLOAD_DIR=/app/uploads

# Use your real server URL or domain here
CORS_ORIGINS=http://YOUR_SERVER_IP

SEED_ADMIN_EMAIL=admin@indcool.com
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_NAME=Administrator

# GST lookup (GST Suvidha Provider, e.g. sandbox.co.in)
# Leave GST_LOOKUP_ENABLED=false to keep live GSTIN verification off (local
# format/checksum validation still works either way).
GST_LOOKUP_ENABLED=false
GST_PROVIDER_URL=https://api.sandbox.co.in/gst/compliance/public/gstin/search
GST_PROVIDER_API_KEY=replace-with-your-gsp-api-key
GST_PROVIDER_API_SECRET=replace-with-your-gsp-api-secret

# Leave empty to use same-origin requests through nginx
VITE_API_BASE_URL=

VITE_GST_LOOKUP_ENABLED=false
# Bump this value to invalidate every browser's cached GST lookups (cache
# normally lasts 1 hour) without waiting out the TTL.
VITE_GST_CACHE_RESET_KEY=1

UI_PORT=80

EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@indcool.in
SMTP_PASSWORD=replace-with-your-smtp-app-password
SMTP_FROM=info@indcool.in
SMTP_FROM_NAME=Indcool Service
SMTP_USE_TLS=true
SMTP_USE_AUTH=true
